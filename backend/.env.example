# ============================================================
# SARP — Sathapana Agricultural Risk Platform
# Environment Variables Configuration
# ============================================================

# --- Database ---
# SQLite for local dev (no install needed)
USE_SQLITE=true
# PostgreSQL + PostGIS for production
# DATABASE_URL=postgresql://sarp:sarp123@localhost:5432/sarp

# --- Google Earth Engine (FREE) ---
# Provides: Sentinel-2 optical, Sentinel-1 SAR, MODIS land cover
# Setup: https://earthengine.google.com/
# 1. Sign up for GEE (free for research/non-commercial)
# 2. Create a GCP project at https://console.cloud.google.com/
# 3. Enable Earth Engine API
# 4. Run: earthengine authenticate
GEE_PROJECT_ID=

# --- CHIRPS Rainfall (FREE, no auth needed) ---
# Provides: Daily global precipitation (0.05° resolution)
# Source: https://data.chc.ucsb.edu/products/CHIRPS-2.0/
# No API key required for basic access
CHIRPS_API_URL=https://data.chc.ucsb.edu/products/CHIRPS-2.0

# --- ERA5 Temperature (FREE, requires CDS account) ---
# Provides: Hourly global temperature, wind, humidity
# Setup: https://cds.climate.copernicus.eu/
# 1. Register (free)
# 2. Go to "API key" page and copy your UID and API key
ERA5_API_URL=https://cds.climate.copernicus.eu/api
ERA5_API_KEY=UID:API_KEY

# --- MRC Flood Data (FREE) ---
# Provides: Mekong River Commission flood alerts
# Setup: https://portal.mrcmekong.org/
MRC_API_URL=

# --- JWT Authentication ---
JWT_SECRET=sarp-poc-secret-change-in-production

# --- Email Notifications (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=sarp@sathapana.com.kh

# --- Server ---
HOST=0.0.0.0
PORT=8000
TOKEN_EXPIRE_MINUTES=480
